{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/izhubs/izdeploy/main/schemas/v0.1/izdeploy.schema.json",
  "title": "izDeploy Application Configuration",
  "description": "Configuration specification for applications deployed with izDeploy v0.1",
  "type": "object",
  "required": [
    "name",
    "port",
    "image"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Unique identifier for the application (DNS-safe lowercase alphanumeric and hyphens, 1-63 chars)"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Internal TCP port exposed by the application container"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "Container image reference (e.g. ghcr.io/org/app:tag or docker.io/library/app:tag)"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Non-sensitive runtime environment variables"
    },
    "build": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "github-actions",
            "host",
            "local",
            "cloud"
          ],
          "default": "github-actions",
          "description": "Build pipeline execution environment (github-actions, host, local, cloud)"
        },
        "builder": {
          "type": "string",
          "enum": [
            "nixpacks",
            "dockerfile"
          ],
          "default": "nixpacks",
          "description": "Container image builder engine (nixpacks, dockerfile)"
        }
      },
      "additionalProperties": false
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "default": "/up"
        },
        "interval_seconds": {
          "type": "integer",
          "default": 3,
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "default": 10,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 32,
          "default": 256,
          "description": "Maximum RAM allocation in megabytes"
        },
        "cpu_cores": {
          "type": "number",
          "minimum": 0.1,
          "default": 1.0,
          "description": "Allocated CPU core fraction"
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of routing domains or path prefixes assigned to the application"
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of host:container persistent volume bind mounts"
    }
  },
  "additionalProperties": false
}
